# AquaPriority Client Environment Configuration Template
# Note: AquaPriority runs entirely in-browser with zero external API keys or backend services.

# Application Port (Default: 5173)
VITE_APP_PORT=5173

# Application Title
VITE_APP_TITLE=AquaPriority - Municipal Water Repair Prioritization

# Demo Telemetry Mode (true / false)
VITE_ENABLE_DEMO_MODE=true
